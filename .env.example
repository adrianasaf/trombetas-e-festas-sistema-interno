# URL do projeto Supabase: Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable): Dashboard > Project Settings > API Keys
# NUNCA coloque a service_role aqui nem em qualquer variável VITE_*.
VITE_SUPABASE_ANON_KEY=
# dev = exibe a faixa "AMBIENTE DE DEMONSTRAÇÃO"; prod = sem faixa
VITE_APP_ENV=dev
